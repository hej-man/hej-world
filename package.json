{
  "name": "terrain-world",
  "version": "0.7.0",
  "private": true,
  "description": "A 3D survival sandbox in the browser, built with Three.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "textures": "sh scripts/get-textures.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/smoke.test.mjs",
    "test:all": "node tests/smoke.test.mjs && node tests/gameplay.test.mjs && node tests/survival.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.6.0",
    "three": "0.160.0",
    "three-mesh-bvh": "0.7.3"
  }
}
